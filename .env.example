# ==============================================================================
# KubeMind: Enterprise Agentic RAG System - Environment Configuration
# ==============================================================================

# --- LLM Providers & Inference (Groq) ---
GROQ_API_KEY=gsk_your_primary_groq_api_key_here
GROQ_FALLBACK_API_KEY=gsk_your_fallback_groq_api_key_here
JUDGE_GROQ=gsk_your_eval_judge_groq_key_here

# --- Vector Database (Qdrant Cloud) ---
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.eu-west-1-0.aws.cloud.qdrant.io

# --- Embedding Model (Google Gemini API) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- LLM Gateway (Portkey) ---
PORTKEY_API_KEY=your_portkey_api_key_here
GROQ_SLUG=rag_8h
GROQ_SLUG_2=rag1-8h

# --- Evaluation Suite (OpenAI LLM-as-a-Judge) ---
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# --- Distributed Tracing (Logfire) ---
LOGFIRE_TOKEN=your_logfire_token_here
